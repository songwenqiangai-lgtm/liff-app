# 生产环境变量模板 —— 复制为 /opt/liff-app/backend/.env 并把值改成本站正式值
# 注意：本文件可保留在 git，真实 .env 被 .gitignore 排除，勿提交真值

# LINE（与开发一致，换成你正式的频道）
LINE_CHANNEL_ID=2011190313
SESSION_SECRET=改成一段足够长的随机字符串（openssl rand -hex 32）
TEACHER_PASSWORD=改成强密码，别再是12345678

# LLM：火山方舟（OpenAI 兼容）
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=你的火山方舟key
LLM_MODEL=你的接入点/模型ID

# 调试后门开关：生产务必为 0
DEV_LOGIN_ENABLED=0