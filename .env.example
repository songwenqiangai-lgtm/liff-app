# 复制为 backend 同目录下的 .env 或部署平台的环境变量
LINE_CHANNEL_ID=1234567890
SESSION_SECRET=改成一串随机字符
TEACHER_PASSWORD=教师仪表盘密码

# LLM API：火山方舟 Agent Plan（OpenAI 兼容协议）
# Agent Plan 用专属端点 /api/plan/v3，专属 Key 以 ark- 开头，与普通方舟 Key 不通用
# 可用模型：deepseek-v4-flash / minimax-m2-7 / doubao-seed-2-1-pro-260628 / ark-code-latest
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
LLM_API_KEY=ark-xxxx
LLM_MODEL=deepseek-v4-flash

# 中文分支（可换成 minimax-m2-7 等中文更强的模型；不填则与上面一致）
LLM_BASE_URL_MM=https://ark.cn-beijing.volces.com/api/plan/v3
LLM_API_KEY_MM=ark-xxxx
LLM_MODEL_MM=deepseek-v4-flash
