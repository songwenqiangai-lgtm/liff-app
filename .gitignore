# 环境/密钥/运行时文件 —— 严禁提交
.env
*.env.local

# 运行时 SQLite（学生/日志/阶段等动态数据）不提交
backend/app.db
backend/app.db-shm
backend/app.db-wal

# 配音音频（97MB，暂不进仓库；部署后另行上传）
backend/audio/
backend/uploads/

# 内容库 content.db 是静态内容（课文/生词/语法/考试），需部署到服务器 → 提交
!content/content.db
# 但导入前的自动备份不提交
content/content.db.bak-*
# 其余 content/ 下的都是开发产物（OCR文字稿/CSV导出/审校表/工具脚本），部署不需要
content/ocr/
content/*.csv
content/*.xlsx
content/*.py
content/tmp/

# Python
__pycache__/
*.pyc
*.pyo
server.log
.venv/
venv/

# 编辑器/开发工具本地配置
.claude/

# 中文班内容构建中间产物（成品在 content.db）
content/g6a/
.fuse_hidden*
